#!/bin/sh
# Prima che i commit escano: controllo meccanico, poi l'agente
# guardiano-privacy. Se uno dei due non dà via libera, il push si ferma.
#
# Git passa su stdin una riga per ramo:
#   <ref locale> <sha locale> <ref remoto> <sha remoto>
set -u
radice=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
commit=""

while read -r _ sha_locale _ sha_remoto; do
  # Cancellare un ramo remoto non pubblica niente.
  [ "$sha_locale" = "$zero" ] && continue
  if [ "$sha_remoto" = "$zero" ]; then
    # Ramo nuovo: tutto ciò che nessun remoto ha ancora.
    nuovi=$(git rev-list "$sha_locale" --not --remotes)
  else
    nuovi=$(git rev-list "$sha_remoto..$sha_locale")
  fi
  commit="$commit $nuovi"
done

# shellcheck disable=SC2086 # gli sha sono parole separate di proposito
set -- $commit
[ "$#" -eq 0 ] && exit 0

node "$radice/scripts/controllo-privacy.mjs" --commit "$@" || exit 1
"$radice/scripts/guardiano.sh" "$@" || exit 1
